{
  "manifest_version": 3,
  "name": "Kestrel native extension probe",
  "version": "1.0.0",
  "permissions": ["storage"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*"],
    "js": ["content.js"]
  }]
}
