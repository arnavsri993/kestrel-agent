    "@kestrel/encryption": "workspace:*",
    "@kestrel/shared-types": "workspace:*",
    "better-sqlite3": "13.0.1",
    "electron-updater": "6.7.2",
    "motion": "12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
