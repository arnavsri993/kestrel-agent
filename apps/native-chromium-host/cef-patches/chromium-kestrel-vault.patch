+        extensions::ExtensionViewHostFactory::CreateSidePanelHost(
+            *extension, frame_url, browser_, /*tab_interface=*/nullptr);
+    if (!kestrel_frame_host_) {
+      LOG(ERROR) << "Kestrel browser frame extension host creation failed.";
+      return;
+    }
+
+    kestrel_frame_load_observer_ =
+        std::make_unique<KestrelBrowserFrameLoadObserver>(
+            kestrel_frame_host_->web_contents(), frame_url,
+            base::BindRepeating(&BrowserView::InvalidateKestrelBrowserFrame,
+                                weak_ptr_factory_.GetWeakPtr()));
+    auto frame_view = std::make_unique<ExtensionViewViews>(
+        GetProfile(), kestrel_frame_host_.get());
+    frame_view->Init();
+    kestrel_frame_view_ = AddChildView(std::move(frame_view));
+    kestrel_frame_view_->SetVisible(false);
+    kestrel_frame_timer_.Start(
+        FROM_HERE, base::Seconds(1),
+        base::BindRepeating(&BrowserView::PollKestrelBrowserFrame,
+                            weak_ptr_factory_.GetWeakPtr()));
+    PollKestrelBrowserFrame();
+    DeprecatedLayoutImmediately();
+    return;
+  }
+
+}
+
+void BrowserView::SetKestrelBrowserFrameReady(bool ready) {
+  if (ready == kestrel_frame_ready_) return;
+  kestrel_frame_ready_ = ready;
+  if (ready) {
+    kestrel_top_was_visible_ = top_container_ && top_container_->GetVisible();
+    kestrel_horizontal_was_visible_ = horizontal_tab_strip_region_view_ &&
+                                      horizontal_tab_strip_region_view_->GetVisible();
+    kestrel_vertical_was_visible_ = vertical_tab_strip_region_view_ &&
+                                    vertical_tab_strip_region_view_->GetVisible();
+    if (top_container_) top_container_->SetVisible(false);
+    if (horizontal_tab_strip_region_view_) horizontal_tab_strip_region_view_->SetVisible(false);
+    if (vertical_tab_strip_region_view_) vertical_tab_strip_region_view_->SetVisible(false);
+  } else {
+    if (top_container_) top_container_->SetVisible(kestrel_top_was_visible_);
+    if (horizontal_tab_strip_region_view_) horizontal_tab_strip_region_view_->SetVisible(kestrel_horizontal_was_visible_);
+    if (vertical_tab_strip_region_view_) vertical_tab_strip_region_view_->SetVisible(kestrel_vertical_was_visible_);
+  }
+  if (kestrel_frame_view_) kestrel_frame_view_->SetVisible(ready);
+  DeprecatedLayoutImmediately();
+}
+
+void BrowserView::InvalidateKestrelBrowserFrame() {
+  ++kestrel_frame_probe_generation_;
+  kestrel_frame_probe_pending_ = false;
+  SetKestrelBrowserFrameReady(false);
+}
+
+void BrowserView::PollKestrelBrowserFrame() {
+  if (!kestrel_frame_host_) return;
+  if (kestrel_frame_probe_pending_) {
+    if (base::TimeTicks::Now() < kestrel_frame_probe_deadline_) return;
+    InvalidateKestrelBrowserFrame();
+  }
+  content::WebContents* contents = kestrel_frame_host_->web_contents();
+  const std::string id = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("kestrel-shell-extension-id");
+  const GURL expected("chrome-extension://" + id + "/index.html?surface=frame");
+  if (!contents || !contents->GetPrimaryMainFrame() ||
+      contents->GetLastCommittedURL() != expected) {
+    InvalidateKestrelBrowserFrame();
+    return;
+  }
+  kestrel_frame_probe_pending_ = true;
+  kestrel_frame_probe_deadline_ = base::TimeTicks::Now() + base::Seconds(3);
+  const uint64_t generation = ++kestrel_frame_probe_generation_;
+  // Fixed code, restricted to the validated private extension host. The
+  // marker is a lease renewed by the real UI only after a bridge round trip.
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      u"(()=>{const d=document.documentElement;const t=Number(d.dataset.kestrelFrameReady);"
+      u"return d.dataset.nativeSurface==='frame'&&Number.isFinite(t)&&t<=Date.now()&&"
+      u"Date.now()-t<15000&&!!document.querySelector('.browser-workspace-native-frame-shell .browser-tab-row')&&"
+      u"!!document.querySelector('.browser-workspace-native-frame-shell .browser-toolbar')})()",
+      base::BindOnce(&BrowserView::OnKestrelBrowserFrameProbe,
+                     weak_ptr_factory_.GetWeakPtr(), generation, expected),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void BrowserView::OnKestrelBrowserFrameProbe(uint64_t generation,
+                                              const GURL& expected,
+                                              base::Value result) {
+  if (!kestrel_frame_probe_pending_ || generation != kestrel_frame_probe_generation_) return;
+  kestrel_frame_probe_pending_ = false;
+  const bool matches = kestrel_frame_host_ && kestrel_frame_host_->web_contents() &&
+      kestrel_frame_host_->web_contents()->GetLastCommittedURL() == expected;
+  SetKestrelBrowserFrameReady(matches && result.is_bool() && result.GetBool());
+}
+
+void BrowserView::DestroyKestrelBrowserFrame() {
+  kestrel_frame_timer_.Stop();
+  InvalidateKestrelBrowserFrame();
+  kestrel_frame_load_observer_.reset();
+  if (kestrel_frame_view_) {
+    views::View* parent = kestrel_frame_view_->parent();
+    if (parent) {
+      parent->RemoveChildViewT(kestrel_frame_view_).reset();
+    }
+    kestrel_frame_view_ = nullptr;
+  }
+  kestrel_frame_host_.reset();
 }
