+class KestrelBrowserFrameLoadObserver final
+    : public content::WebContentsObserver {
+ public:
+  KestrelBrowserFrameLoadObserver(content::WebContents* contents,
+                                  GURL expected_url)
+      : content::WebContentsObserver(contents),
+        expected_url_(std::move(expected_url)) {}
+
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override {
+    if (reported_ || !navigation_handle->HasCommitted() ||
+        !navigation_handle->IsInPrimaryMainFrame() ||
+        navigation_handle->GetURL() != expected_url_) {
+      return;
+    }
+    reported_ = true;
+    LOG(INFO) << "KESTREL_CHROMIUM_BROWSER_FRAME_DOCUMENT_LOADED";
+    // Keep existing native smoke receipts bound to the real Kestrel document.
+    LOG(INFO) << "KESTREL_CHROMIUM_DESKTOP_DOCUMENT_LOADED";
+  }
+
+ private:
+  const GURL expected_url_;
+  bool reported_ = false;
+};
+
+class KestrelBrowserFrameExtensionObserver final
+    : public extensions::ExtensionRegistryObserver {
+ public:
+  KestrelBrowserFrameExtensionObserver(
+      extensions::ExtensionRegistry* registry,
+      std::string extension_id,
+      base::RepeatingClosure on_loaded,
+      base::RepeatingClosure on_unloaded)
+      : extension_id_(std::move(extension_id)),
+        on_loaded_(std::move(on_loaded)),
+        on_unloaded_(std::move(on_unloaded)) {
+    observation_.Observe(registry);
+  }
+
+  void OnExtensionLoaded(content::BrowserContext*,
+                         const extensions::Extension* extension) override {
+    if (extension->id() == extension_id_) {
+      on_loaded_.Run();
+    }
+  }
+
+  void OnExtensionUnloaded(
+      content::BrowserContext*,
+      const extensions::Extension* extension,
+      extensions::UnloadedExtensionReason) override {
+    if (extension->id() == extension_id_) {
+      on_unloaded_.Run();
+    }
+  }
+
+ private:
+  const std::string extension_id_;
+  base::RepeatingClosure on_loaded_;
+  base::RepeatingClosure on_unloaded_;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      observation_{this};
+};
