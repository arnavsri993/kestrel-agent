diff --git a/components/os_crypt/async/browser/kestrel_vault_key_provider.cc b/components/os_crypt/async/browser/kestrel_vault_key_provider.cc
new file mode 100644
index 0000000000000000000000000000000000000000..ebb613eb11a52b8f7c23ab1b5e22429eb6c756e7
--- /dev/null
+++ b/components/os_crypt/async/browser/kestrel_vault_key_provider.cc
@@ -0,0 +1,100 @@
+// Copyright 2026 The Kestrel Authors.
+// Use of this source code is governed by a BSD-style license.
+
+#include "components/os_crypt/async/browser/kestrel_vault_key_provider.h"
+
+#include <algorithm>
+#include <array>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "base/types/expected.h"
+#include "components/os_crypt/async/common/algorithm.mojom.h"
+#include "crypto/secure_util.h"
+
+namespace os_crypt_async {
+namespace {
+
+// Versioned, non-overlapping with upstream v10/v11/v20 prefixes. This tag is
+// specific to Kestrel-derived browser keys; it never denotes a static key.
+constexpr char kKestrelKeyTag[] = "v99";
+enum class State { kUnset, kConfigured, kFrozen, kConsumed };
+struct Configuration {
+  base::Lock lock;
+  State state = State::kUnset;
+  std::array<uint8_t, Encryptor::Key::kAES256GCMKeySize> key = {};
+};
+
+Configuration& GetConfiguration() {
+  // No exit-time destructor and no accidental key copy. The staging bytes are
+  // explicitly erased before any Encryptor instance is vended.
+  static base::NoDestructor<Configuration> configuration;
+  return *configuration;
+}
+
+}  // namespace
+
+bool ConfigureKestrelVaultKey(base::span<const uint8_t> browser_key) {
+  if (browser_key.size() != Encryptor::Key::kAES256GCMKeySize) {
+    return false;
+  }
+  auto& configuration = GetConfiguration();
+  base::AutoLock lock(configuration.lock);
+  if (configuration.state != State::kUnset) {
+    return false;
+  }
+  std::ranges::copy(browser_key, configuration.key.begin());
+  configuration.state = State::kConfigured;
+  return true;
+}
+
+bool FreezeKestrelVaultConfiguration() {
+  auto& configuration = GetConfiguration();
+  base::AutoLock lock(configuration.lock);
+  if (configuration.state != State::kConfigured) {
+    return false;
+  }
+  configuration.state = State::kFrozen;
+  return true;
+}
+
+bool IsKestrelVaultEnabled() {
+  auto& configuration = GetConfiguration();
+  base::AutoLock lock(configuration.lock);
+  return configuration.state == State::kFrozen ||
+         configuration.state == State::kConsumed;
+}
+
+KestrelVaultKeyProvider::KestrelVaultKeyProvider() {
+  auto& configuration = GetConfiguration();
+  base::AutoLock lock(configuration.lock);
+  if (configuration.state != State::kFrozen) {
+    return;
+  }
+  key_.emplace(base::span<const uint8_t>(configuration.key),
+               mojom::Algorithm::kAES256GCM);
+  crypto::SecureZeroBuffer(configuration.key);
+  configuration.state = State::kConsumed;
+}
+
+KestrelVaultKeyProvider::~KestrelVaultKeyProvider() = default;
+
+void KestrelVaultKeyProvider::GetKey(KeyCallback callback) {
+  if (!key_) {
+    // Unavailability must NEVER be reported as permanent: callers may delete
+    // ciphertext after kPermanentlyUnavailable. Stop/re-unlock/restart instead.
+    std::move(callback).Run(
+        kKestrelKeyTag, base::unexpected(KeyError::kTemporarilyUnavailable));
+    return;
+  }
+  auto key = std::move(*key_);
+  key_.reset();
+  std::move(callback).Run(kKestrelKeyTag, std::move(key));
+}
+
+bool KestrelVaultKeyProvider::UseForEncryption() {
+  return true;
+}
+
+}  // namespace os_crypt_async
