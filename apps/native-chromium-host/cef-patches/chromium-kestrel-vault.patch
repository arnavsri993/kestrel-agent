+void BrowserView::MaybeCreateKestrelBrowserFrame() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("kestrel-browser-frame")) {
+    return;
+  }
+
+  const std::string extension_id =
+      command_line->GetSwitchValueASCII("kestrel-shell-extension-id");
+  const base::FilePath extension_path =
+      command_line->GetSwitchValuePath("kestrel-shell-extension-path");
+  if (extension_id.size() != 32 ||
+      extension_id.find_first_not_of("abcdefghijklmnop") != std::string::npos ||
+      extension_path.empty()) {
+    LOG(ERROR) << "Kestrel browser frame is missing its trusted extension "
+                  "identity.";
+    return;
+  }
+
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(GetProfile());
+  if (!registry) {
+    LOG(ERROR) << "Kestrel browser frame cannot access the profile extension "
+                  "registry.";
+    return;
+  }
+
+  if (!kestrel_frame_extension_observer_) {
+    kestrel_frame_extension_observer_ =
+        std::make_unique<KestrelBrowserFrameExtensionObserver>(
+            registry, extension_id,
+            base::BindRepeating(
+                &BrowserView::MaybeCreateKestrelBrowserFrame,
+                weak_ptr_factory_.GetWeakPtr()),
+            base::BindRepeating(&BrowserView::DestroyKestrelBrowserFrame,
+                                weak_ptr_factory_.GetWeakPtr()));
+    LOG(INFO) << "Kestrel browser frame is waiting for its bundled UI extension.";
+  }
+
+  const extensions::Extension* extension =
+      registry->enabled_extensions().GetByID(extension_id);
+  if (extension) {
+    if (extension->path() != extension_path) {
+      LOG(ERROR) << "Kestrel browser frame extension path did not match its "
+                    "startup identity.";
+      return;
+    }
+    if (kestrel_frame_view_) {
+      return;
+    }
+
+    const GURL frame_url("chrome-extension://" + extension_id +
+                         "/index.html?surface=frame");
