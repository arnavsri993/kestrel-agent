+
+#ifndef COMPONENTS_OS_CRYPT_ASYNC_BROWSER_KESTREL_VAULT_KEY_PROVIDER_H_
+#define COMPONENTS_OS_CRYPT_ASYNC_BROWSER_KESTREL_VAULT_KEY_PROVIDER_H_
+
+#include <optional>
+#include "base/component_export.h"
+#include "base/containers/span.h"
+#include "components/os_crypt/async/browser/key_provider.h"
+
+namespace os_crypt_async {
+
+// Browser-process in-memory configuration. No key material is serialized by
+// these functions. Call once before CefInitialize; no runtime replacement.
+COMPONENT_EXPORT(OS_CRYPT_ASYNC)
+bool ConfigureKestrelVaultKey(base::span<const uint8_t> browser_key);
+COMPONENT_EXPORT(OS_CRYPT_ASYNC)
+bool FreezeKestrelVaultConfiguration();
+COMPONENT_EXPORT(OS_CRYPT_ASYNC)
+bool IsKestrelVaultEnabled();
+
+class COMPONENT_EXPORT(OS_CRYPT_ASYNC) KestrelVaultKeyProvider final
+    : public KeyProvider {
+ public:
+  KestrelVaultKeyProvider();
+  ~KestrelVaultKeyProvider() override;
+  void GetKey(KeyCallback callback) override;
+  bool UseForEncryption() override;
+
+ private:
+  std::optional<Encryptor::Key> key_;
+};
+
+}  // namespace os_crypt_async
+#endif  // COMPONENTS_OS_CRYPT_ASYNC_BROWSER_KESTREL_VAULT_KEY_PROVIDER_H_
