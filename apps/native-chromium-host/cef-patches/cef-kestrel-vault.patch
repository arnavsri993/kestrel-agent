@@ -0,0 +1,44 @@
+// Copyright 2026 The Kestrel Authors.
+// Use of this source code is governed by a BSD-style license.
+
+#ifndef CEF_INCLUDE_CEF_KESTREL_VAULT_H_
+#define CEF_INCLUDE_CEF_KESTREL_VAULT_H_
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include "include/internal/cef_export.h"
+
+// Hand-written C ABI extension to this pinned Kestrel CEF framework. This is
+// deliberately independent of the generated CEF C++/CAPI translator and API
+// hash: no wrapper, generated struct layout or stock CEF ABI is changed.
+// macOS only. Hosts must require BOTH symbols and this exact version before
+// any CefInitialize call; stock CEF is unsupported and must fail closed.
+#define CEF_KESTREL_VAULT_API_VERSION 1u
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+CEF_EXPORT unsigned int cef_kestrel_vault_api_version(void);
+
+// On the main thread BEFORE the first CefInitialize, supply exactly 32 bytes
+// of an HKDF-separated browser key. If the main host calls CefExecuteProcess,
+// it must return -1 first. macOS separate-helper hosts need not call it here.
+// The derived browser key must come from
+// the already unlocked Kestrel vault. Never pass the vault master key.
+// Returns 1 only once; rejects helpers, replacement and late configuration.
+// For any non-null exactly-32-byte input, copies when accepted and securely
+// zeros the caller-owned buffer before returning, including on rejection.
+// The caller owns this writable buffer and must never alias the master key.
+// The framework clears its staging copy once the provider constructs the
+// Chromium Encryptor::Key. Only Chromium's private Encryptor Mojo plumbing
+// may pass the DERIVED key to its network service; never to renderer/JS.
+// No key, callback, secret, or token is read from argv, env or the filesystem.
+CEF_EXPORT int cef_kestrel_vault_configure(uint8_t* browser_key,
+                                          size_t browser_key_size);
+
+#ifdef __cplusplus
+}
+#endif
+#endif  // CEF_INCLUDE_CEF_KESTREL_VAULT_H_
