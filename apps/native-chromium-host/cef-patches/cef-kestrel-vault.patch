@@ -204,6 +212,31 @@ int CefExecuteProcess(const CefMainArgs& args,
                                            windows_sandbox_info);
 }

+#if BUILDFLAG(IS_MAC)
+extern "C" CEF_EXPORT unsigned int cef_kestrel_vault_api_version(void) {
+  return CEF_KESTREL_VAULT_API_VERSION;
+}
+
+extern "C" CEF_EXPORT int cef_kestrel_vault_configure(uint8_t* browser_key,
+                                                     size_t browser_key_size) {
+  // Main-thread browser-process only. macOS hosts with a separate helper may
+  // not call CefExecuteProcess in the main executable before this API.
+  if (!browser_key || browser_key_size != 32u) {
+    return 0;
+  }
+  auto bytes = base::span<uint8_t>(browser_key, browser_key_size);
+  const bool browser_process =
+      !base::CommandLine::InitializedForCurrentProcess() ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch("type");
+  const bool configured = browser_process && !g_context &&
+      os_crypt_async::ConfigureKestrelVaultKey(bytes);
+  // Consume the caller's derived-key buffer on success AND rejection. Never
+  // accept a master secret here; it remains exclusively in the host vault.
+  crypto::SecureZeroBuffer(bytes);
+  return configured ? 1 : 0;
+}
+#endif  // BUILDFLAG(IS_MAC)
+
 bool CefInitialize(const CefMainArgs& args,
                    const CefSettings& settings,
                    CefRefPtr<CefApp> application,
@@ -223,5 +256,21 @@ bool CefInitialize(const CefMainArgs& args,
     return false;
   }

+#if BUILDFLAG(IS_MAC)
+  // Kestrel-only framework: a stock/missing/unlocked-too-late provider must
+  // never open the profile or fall back to the system Keychain. This precedes
+  // CefContext::Initialize, cache-path normalization and Chromium startup.
+  bool secondary_process = false;
+  for (int i = 1; i < args.argc; ++i) {
+    const std::string_view arg(args.argv[i]);
+    secondary_process |= arg == "--type" || arg.starts_with("--type=");
+  }
+  if (secondary_process ||
+      !os_crypt_async::FreezeKestrelVaultConfiguration()) {
+    g_exit_code = 1;
+    return false;
+  }
+#endif
+
   // Create the new global context object.
   g_context = new CefContext();
