{
  "name": "kestrel-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kestrel \u2014 a local-first work agent with visible approvals and verified delivery",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kestrel/desktop dev",
    "dev:desktop": "pnpm --filter @kestrel/desktop dev",
    "dev:website": "pnpm --filter @kestrel/website dev",
    "cli": "tsx apps/cli/src/index.ts",
    "build": "pnpm -r --if-present build",
    "build:desktop": "pnpm --filter @kestrel/desktop build",
    "build:website": "pnpm --filter @kestrel/website build",
    "benchmark:browser-agent": "node scripts/run-browser-agent-benchmark.mjs",
    "benchmark:browser-agent:packaged:arm64": "KESTREL_DESKTOP_EXECUTABLE=release/mac-arm64/Kestrel.app/Contents/MacOS/Kestrel node scripts/run-browser-agent-benchmark.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "tsx scripts/scan-production-secrets.ts",
    "audit:settings": "node scripts/audit-settings-parity.mjs",
    "audit:references": "node scripts/audit-reference-docs.mjs --verify",
    "audit:market": "node scripts/verify-market-release.mjs",
    "test:packaged-cli": "node scripts/smoke-packaged-cli.mjs",
    "test:desktop-smoke": "node scripts/smoke-desktop.mjs",
    "test:desktop-single-instance": "node scripts/test-desktop-single-instance.mjs",
    "test:desktop-browser": "node scripts/test-desktop-browser.mjs",
    "test:desktop-layout": "node scripts/test-desktop-layout.mjs",
    "test:desktop-settings": "node scripts/test-desktop-settings.mjs",
    "test:desktop-writing-studio": "node scripts/test-desktop-writing-studio.mjs",
    "test:desktop-file-icon-guard": "node scripts/test-desktop-file-icon-guard.mjs",
    "test:desktop-fresh-profile": "node scripts/test-desktop-fresh-profile.mjs",
    "test:desktop-restart-recovery": "node scripts/test-desktop-restart-recovery.mjs",
    "test:desktop-workflow-reuse": "node scripts/test-desktop-workflow-reuse.mjs",
    "test:desktop-personas": "node scripts/test-desktop-personas.mjs",
    "test:desktop-kanban": "node scripts/test-desktop-kanban.mjs",
    "test:desktop-model-routing": "node scripts/test-desktop-model-routing.mjs",
    "test:packaged-desktop:arm64": "KESTREL_DISABLE_UPDATES=1 KESTREL_DESKTOP_EXECUTABLE=release/mac-arm64/Kestrel.app/Contents/MacOS/Kestrel node scripts/smoke-desktop.mjs",
    "test:packaged-desktop-life-context:arm64": "KESTREL_DESKTOP_EXECUTABLE=release/mac-arm64/Kestrel.app/Contents/MacOS/Kestrel node scripts/test-desktop-life-context.mjs",
    "test:desktop-setup": "node scripts/test-desktop-setup.mjs",
    "test:local-ai:real": "KESTREL_RUN_REAL_LOCAL_AI=1 tsx scripts/smoke-managed-local-ai.ts",
    "test:desktop-readiness": "node scripts/test-desktop-readiness.mjs",
    "test:desktop-external-secrets": "node scripts/test-desktop-external-secrets.mjs",
    "test:desktop-external-secrets:real": "WORKSTRAND_TEST_REAL_BWS=1 node scripts/test-desktop-external-secrets.mjs",
    "test:desktop-observability": "node scripts/test-desktop-observability.mjs",
    "test:desktop-life-context": "node scripts/test-desktop-life-context.mjs",
    "test:desktop-approvals": "node scripts/test-desktop-approvals.mjs",
    "test:desktop-chat-configuration": "node scripts/test-desktop-chat-configuration.mjs",
    "test:desktop-managed-policy": "node scripts/test-desktop-managed-policy.mjs",
    "capture:desktop": "tsx scripts/capture-desktop.ts",
    "capture:ui-audit": "tsx scripts/capture-ui-audit.ts",
    "test:editors": "node scripts/verify-editor-integrations.mjs",
    "test:e2e": "playwright test",
    "package:mac:dev": "pnpm --filter @kestrel/desktop package:mac:dev && node scripts/cleanup-kestrel-macos-apps.mjs",
    "package:mac:installable": "pnpm --filter @kestrel/desktop package:mac:installable",
    "install:mac:dev": "pnpm package:mac:dev && node scripts/install-development-macos-app.mjs",
    "assets:hero": "tsx scripts/fal-generate-hero.ts",
    "assets:backgrounds": "tsx scripts/fal-generate-backgrounds.ts",
    "assets:posters": "tsx scripts/fal-generate-posters.ts",
    "assets:process": "tsx scripts/process-marketing-assets.ts",
    "assets:verify": "tsx scripts/verify-marketing-assets.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm audit:settings && pnpm audit:references && pnpm audit:market && pnpm build && pnpm benchmark:browser-agent && pnpm test:e2e && pnpm test:desktop-smoke && pnpm test:desktop-single-instance && pnpm test:desktop-layout && pnpm test:desktop-settings && pnpm test:desktop-writing-studio && pnpm test:desktop-file-icon-guard && pnpm test:desktop-browser && pnpm test:desktop-setup && pnpm test:desktop-fresh-profile && pnpm test:desktop-restart-recovery && pnpm test:desktop-workflow-reuse && pnpm test:desktop-personas && pnpm test:desktop-kanban && pnpm test:desktop-model-routing && pnpm test:desktop-readiness && pnpm test:desktop-external-secrets && pnpm test:desktop-observability && pnpm test:desktop-life-context && pnpm test:desktop-approvals && pnpm test:desktop-chat-configuration && pnpm test:desktop-managed-policy && pnpm test:packaged-cli && pnpm test:editors && pnpm test:security",
    "verify:meetup": "node scripts/verify-meetup-preflight.mjs && pnpm verify && pnpm assets:verify && pnpm test:local-ai:real && pnpm package:mac:dev && pnpm test:packaged-desktop:arm64 && pnpm benchmark:browser-agent:packaged:arm64",
    "check:presentation-warmup": "node scripts/presentation-warmup-check.mjs",
    "cleanup:mac:apps": "node scripts/cleanup-kestrel-macos-apps.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@fal-ai/client": "1.10.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "zod": "4.4.3"
  }
}
